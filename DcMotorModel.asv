numDcMotor = M1.Kt;
denDcMotor = [M1.Ls*M1.Jr M1.Rs*M1.Jr M1.Kt*M1.Ke];

%% Transfer Function
tfDcMotor = tf(numDcMotor, denDcMotor);

%% Bode Plot
% figure;
% bode(tfDcMotor);
% grid on;
% title('DC Motor Bode Diagram');

%% Poles and Zeros
% fprintf('=============================\n');
% fprintf('DC Motor Transfer Function\n');
% fprintf('=============================\n\n');
% 
% fprintf('Poles:\n');
% disp(pole(tfDcMotor));
% 
% fprintf('Zeros:\n');
% disp(zero(tfDcMotor));

%% Root Locus
% figure;
% rlocus(tfDcMotor);
% grid on;
% title('DC Motor Root Locus');
% 
% Kp = 10^(-27/20);
% Controller = Kp * tf([1 100], [1 0]);
% figure;
% bode(Controller * tfDcMotor);
% grid on;
% title('DC Motor Bode Diagram with controller');
% 
% T = feedback(Controller * tfDcMotor, 1);
% pole(T)
% step(T)

%% DOB Design
% g_v = 100;
% g_dob = 100;

%% Current Controller Design
tFuncElec = tf(1, [M1.Ls M1.Rs]);
bode(tFuncElec);

controller = tf(Kp)

% Ana struct tanımlaması
kontrolculer = struct();

% Akım kontrolcüsü parametreleri
kontrolculer.akim.Kp = 1.0;
kontrolculer.akim.Ki = 0.1;
kontrolculer.akim.Kd = 0.0;
kontrolculer.akim.Kaw = 0.0;

% Hız kontrolcüsü parametreleri
kontrolculer.hiz.Kp = 2.5;
kontrolculer.hiz.Ki = 0.5;
kontrolculer.hiz.Kd = 0.01;
kontrolculer.hiz.Kaw = 0.1;

% Pozisyon kontrolcüsü parametreleri
kontrolculer.poz.Kp = 10.0;
kontrolculer.poz.Ki = 1.0;
kontrolculer.poz.Kd = 0.05;
kontrolculer.poz.Kaw = 0.2;